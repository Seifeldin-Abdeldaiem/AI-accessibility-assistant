# Required for AI explanations and fixes. Without it the tool still runs
# and reports every automated finding — it just can't explain or fix them.
ANTHROPIC_API_KEY=

# Model used for explanations/fixes and for alt-text vision suggestions.
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_VISION_MODEL=claude-sonnet-5

# Soft per-scan spend guard, in USD (estimated from token usage — set a
# real cap in your Anthropic console too).
MAX_SCAN_SPEND_USD=0.50

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Never set this to true in a deployment reachable from the internet.
# It disables the SSRF protection so localhost/private test pages can be
# scanned during local development.
ALLOW_PRIVATE_NETWORKS=false

# Leave unset unless Chromium is installed to a non-default location, e.g.
# the pre-installed browser in this repo's cloud dev container:
# PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
